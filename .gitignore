# Internal review history of the paper and the frozen workshop submission: kept on disk, not
# published. Anchored to /paper/ so no other `build/` or `wave*` directory is affected.
/paper/.pairtex/
/paper/build/wave*/
/paper/build/theissen_0919/
/paper/build/feedback_archive/
/paper/build/submitted_ml4ps_2026/
# LaTeX build artefacts of the paper. Anchored to /paper/ rather than a repo-wide `*.aux`: these
# regenerate on every latexmk run, and the compiled main.pdf is committed deliberately as the
# collaborator-facing draft.
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.out
/paper/*.fdb_latexmk
/paper/*.fls
/paper/*.synctex.gz

# Per-run training artifacts (any depth, deliberate)
best.pt
result.json
DONE.txt

